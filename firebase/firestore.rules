// Firestore Security Rules — mi_plancha
//
// Ver DATA_MODEL.md para el esquema completo y ARCHITECTURE.md para por qué no hay
// backend (Firebase plan Spark, sin Cloud Functions): estas reglas son la ÚNICA capa
// de validación de servidor de todo el sistema. No hay Admin SDK que repare datos
// inconsistentes ni custom claims — el rol de cada usuario vive en `usuarios/{uid}.rol`
// y se resuelve aquí con get().
//
// Multi-empresa: `empresas/{empresaId}` es la entidad por encima de todo (ver
// DATA_MODEL.md). Casi todas las colecciones operativas viven anidadas bajo
// `empresas/{empresaId}/...` — el aislamiento entre empresas se deriva directamente
// de la ruta, no de un campo. La única excepción es la collectionGroup query sobre
// `lineas` (ver más abajo), que no puede acotarse por ruta.
//
// Límite conocido y aceptado para el MVP (app interna, solo personal de confianza):
// dentro de una misma transacción del cliente (ej. "abrir mesa" = crear cliente +
// actualizar mesa), cada documento se valida por separado; las reglas no pueden
// garantizar el invariante cruzado entre ambos documentos, solo que cada uno, por sí
// mismo, hace una transición válida. La atomicidad y consistencia del par depende de
// que el cliente (Angular/SwiftUI/Compose) use siempre `runTransaction` como se
// describe en DATA_MODEL.md.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function autenticado() {
      return request.auth != null;
    }

    function usuarioDoc(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    // Un usuario desactivado (activo:false) no debe poder operar aunque
    // conserve su rol — ver criterio de aceptación de ADM-07 en USER_STORIES.md.
    function esSuperadmin() {
      return autenticado()
        && usuarioDoc(request.auth.uid).activo == true
        && usuarioDoc(request.auth.uid).rol == 'superadmin';
    }

    function miEmpresaId() {
      return usuarioDoc(request.auth.uid).empresaId;
    }

    // Reemplaza al antiguo esRol(r) de la versión single-tenant: añade el
    // aislamiento por empresa a cada comprobación de rol.
    function esRolEnEmpresa(r, empresaId) {
      return autenticado()
        && usuarioDoc(request.auth.uid).activo == true
        && usuarioDoc(request.auth.uid).rol == r
        && miEmpresaId() == empresaId;
    }

    function soloCambianCampos(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // ---------- usuarios (plana, no anidada bajo empresas/ — ver DATA_MODEL.md) ----------
    match /usuarios/{uid} {
      // Cualquier autenticado ve su propio doc (lo necesita para resolver su
      // sesión); superadmin ve todos; el resto, solo los de su propia empresa
      // (para mostrar nombres/roles en la UI, ej. quién tomó un pedido).
      allow read: if autenticado()
        && (esSuperadmin() || uid == request.auth.uid || usuarioDoc(uid).empresaId == miEmpresaId());

      // Alta: el superadmin da de alta cualquier rol en cualquier empresa
      // (incluido el administrador dedicado al crear una empresa, ver
      // EmpresasService.crearConAdmin); un administrador solo da de alta
      // camarero/cocinero, y solo en su propia empresa — nunca otro
      // administrador ni otra empresa.
      allow create: if esSuperadmin()
        || (esRolEnEmpresa('administrador', request.resource.data.empresaId)
            && request.resource.data.rol in ['camarero', 'cocinero']);

      // Edición: mismo criterio — un administrador nunca toca una cuenta de
      // administrador/superadmin ni cambia a alguien de empresa.
      allow update: if esSuperadmin()
        || (esRolEnEmpresa('administrador', resource.data.empresaId)
            && resource.data.rol in ['camarero', 'cocinero']
            && request.resource.data.rol in ['camarero', 'cocinero']
            && request.resource.data.empresaId == resource.data.empresaId);

      // Borrado (nuevo, no existía en la versión single-tenant): borra solo
      // el documento Firestore — la cuenta de Firebase Auth queda huérfana,
      // ya que no hay Admin SDK en el cliente para borrarla (mismo límite ya
      // aceptado para las apps móviles huérfanas, ver PROGRESS.md). Nunca se
      // puede borrar un administrador/superadmin, solo desactivarlo.
      allow delete: if esSuperadmin()
        || (esRolEnEmpresa('administrador', resource.data.empresaId) && resource.data.rol in ['camarero', 'cocinero']);
    }

    // ---------- empresas ----------
    match /empresas/{empresaId} {
      // Lectura: el superadmin ve todas; el resto, solo la suya (para
      // mostrar su propio nombre de empresa en la UI, ej. Topbar).
      allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);

      allow create: if esSuperadmin()
        && request.resource.data.codigo == empresaId
        && request.resource.data.activa == true;

      // También cubre el "borrado" (activa:false, ver EmpresasService) — no
      // hay borrado real, es un histórico con todo su personal/datos, igual
      // que cuentas/ nunca se borra.
      allow update: if esSuperadmin();
      allow delete: if false;

      // ---------- mesas ----------
      match /mesas/{numero} {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);

        // Alta/baja de mesas: solo el administrador de esta empresa, a
        // partir de config/mesas.numeroDeMesas. Una mesa nueva siempre nace
        // libre; una mesa ocupada no se puede borrar (evita dejar un cliente
        // con la mesa desaparecida bajo los pies).
        allow create: if esRolEnEmpresa('administrador', empresaId)
          && request.resource.data.estado == 'libre'
          && request.resource.data.clienteId == null;
        allow delete: if esRolEnEmpresa('administrador', empresaId) && resource.data.estado == 'libre';

        // Abrir mesa (libre -> ocupada) o generar cuenta / liberar (ocupada -> libre).
        allow update: if esRolEnEmpresa('camarero', empresaId)
          && soloCambianCampos(['estado', 'clienteId'])
          && (
            (resource.data.estado == 'libre' && request.resource.data.estado == 'ocupada'
              && request.resource.data.clienteId != null)
            || (resource.data.estado == 'ocupada' && request.resource.data.estado == 'libre'
              && request.resource.data.clienteId == null)
          );
      }

      // ---------- clientes ----------
      match /clientes/{clienteId} {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);

        allow create: if esRolEnEmpresa('camarero', empresaId)
          && request.resource.data.camareroId == request.auth.uid
          && get(/databases/$(database)/documents/empresas/$(empresaId)/mesas/$(request.resource.data.mesaId)).data.estado == 'libre';

        allow update: if false; // datos de apertura inmutables

        allow delete: if esRolEnEmpresa('camarero', empresaId); // generar cuenta libera al cliente
      }

      // ---------- pedidos ----------
      match /pedidos/{pedidoId} {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);

        allow create: if esRolEnEmpresa('camarero', empresaId)
          && request.resource.data.camareroId == request.auth.uid
          && request.resource.data.cocineroId == null
          && request.resource.data.cuentaId == null;

        // Tomar pedido: exclusividad — solo si nadie lo había tomado ya.
        allow update: if esRolEnEmpresa('cocinero', empresaId)
          && resource.data.cocineroId == null
          && request.resource.data.cocineroId == request.auth.uid
          && soloCambianCampos(['cocineroId']);

        // Marcarlo como facturado, al generar la cuenta de su cliente.
        allow update: if esRolEnEmpresa('camarero', empresaId)
          && resource.data.cuentaId == null
          && request.resource.data.cuentaId != null
          && soloCambianCampos(['cuentaId']);

        // Un pedido ya facturado (cuentaId asignado) se puede borrar para
        // limpiar la lista de completados del cocinero que lo llevó — la
        // cuenta ya lo tiene todo (nombres, precios, total) en cuentas/, así
        // que el pedido operativo deja de hacer falta. Antes de facturar, no
        // se puede borrar (se conserva como historial operativo, ver
        // DATA_MODEL.md).
        allow delete: if esRolEnEmpresa('cocinero', empresaId)
          && resource.data.cocineroId == request.auth.uid
          && resource.data.cuentaId != null;
      }

      match /pedidos/{pedidoId}/lineas/{lineaId} {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);

        // La cantidad no puede superar el stock actual del producto
        // (criterio de aceptación de CAM-03).
        allow create: if esRolEnEmpresa('camarero', empresaId)
          && request.resource.data.estado == 'pendiente'
          && request.resource.data.cantidad > 0
          && request.resource.data.cantidad
            <= get(/databases/$(database)/documents/empresas/$(empresaId)/productos/$(request.resource.data.productoId)).data.stock;

        // Colocar en la plancha o retirarla (pendiente de entrega): solo el
        // cocinero asignado al pedido padre, respetando la secuencia
        // pendiente -> en_plancha -> pendiente_entrega.
        allow update: if esRolEnEmpresa('cocinero', empresaId)
          && get(/databases/$(database)/documents/empresas/$(empresaId)/pedidos/$(pedidoId)).data.cocineroId == request.auth.uid
          && (
            (resource.data.estado == 'pendiente' && request.resource.data.estado == 'en_plancha')
            || (resource.data.estado == 'en_plancha' && request.resource.data.estado == 'pendiente_entrega')
          );

        // Confirmar entrega en mesa: la hace el camarero responsable del pedido
        // (es quien la lleva físicamente a la mesa), no el cocinero — único
        // tramo de la secuencia que cambia de rol.
        allow update: if esRolEnEmpresa('camarero', empresaId)
          && get(/databases/$(database)/documents/empresas/$(empresaId)/pedidos/$(pedidoId)).data.camareroId == request.auth.uid
          && resource.data.estado == 'pendiente_entrega'
          && request.resource.data.estado == 'listo';

        // Mismo criterio que borrar el pedido padre: solo una vez facturado, y
        // solo el cocinero que lo llevó.
        allow delete: if esRolEnEmpresa('cocinero', empresaId)
          && get(/databases/$(database)/documents/empresas/$(empresaId)/pedidos/$(pedidoId)).data.cocineroId == request.auth.uid
          && get(/databases/$(database)/documents/empresas/$(empresaId)/pedidos/$(pedidoId)).data.cuentaId != null;
      }

      // ---------- productos ----------
      match /productos/{productoId} {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);

        // CMS: alta, precio, capacidad, tiempo de cocción. Ninguno puede ser negativo
        // (criterio de aceptación de ADM-01).
        allow create, update: if esRolEnEmpresa('administrador', empresaId)
          && request.resource.data.capacidadUnidad >= 0
          && request.resource.data.tiempoCoccionSeg >= 0
          && request.resource.data.stock >= 0
          && request.resource.data.precio >= 0;
        allow delete: if esRolEnEmpresa('administrador', empresaId);

        // Descuento de stock al colocar un producto en la plancha: el cocinero
        // solo puede tocar `stock`, y solo para bajarlo (nunca negativo). No hay forma
        // de atar aquí el descuento a la línea de pedido exacta que lo originó —
        // límite de confianza aceptado (ver cabecera de este archivo).
        allow update: if esRolEnEmpresa('cocinero', empresaId)
          && soloCambianCampos(['stock'])
          && request.resource.data.stock >= 0
          && request.resource.data.stock <= resource.data.stock;
      }

      // ---------- cuentas (histórico permanente) ----------
      match /cuentas/{cuentaId} {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);
        allow create: if esRolEnEmpresa('camarero', empresaId) && request.resource.data.camareroId == request.auth.uid;
        allow update, delete: if false; // registro histórico inmutable
      }

      // ---------- config (CMS) ----------
      // Un bloque por documento (en vez de uno genérico /config/{doc}) para poder
      // validar cada uno con sus propias reglas de rango — un match genérico que
      // solapara con estos se combinaría con OR y anularía la validación (las
      // reglas de Firestore no se "sobrescriben" por especificidad).
      match /config/plancha {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);
        allow write: if esRolEnEmpresa('administrador', empresaId) && request.resource.data.capacidadTotal > 0;
      }
      match /config/division {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);
        allow write: if esRolEnEmpresa('administrador', empresaId)
          && request.resource.data.umbral > 0
          && request.resource.data.tamanoSubgrupo > 0;
      }
      match /config/antiInanicion {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);
        allow write: if esRolEnEmpresa('administrador', empresaId) && request.resource.data.tiempoMaximoEsperaMin > 0;
      }
      match /config/overflow {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);
        allow write: if esRolEnEmpresa('administrador', empresaId)
          && request.resource.data.porcentaje >= 0
          && request.resource.data.porcentaje <= 100;
      }
      match /config/mesas {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);
        allow write: if esRolEnEmpresa('administrador', empresaId) && request.resource.data.numeroDeMesas > 0;
      }

      // ---------- plancha (estado operativo, no confundir con config/plancha) ----------
      match /plancha/estado {
        allow read: if esSuperadmin() || (autenticado() && miEmpresaId() == empresaId);
        allow write: if esRolEnEmpresa('cocinero', empresaId)
          && soloCambianCampos(['overflowManualActivo', 'activadoPor', 'activadoEn']);
      }
    }

    // Firestore NO aplica las reglas anidadas de arriba a collectionGroup('lineas')
    // — solo gobiernan get()/list() sobre la subcolección de un pedido concreto
    // (`collection(db,'empresas',empresaId,'pedidos',id,'lineas')`). Para las
    // collection group queries (PlanchaService, SugerenciaService,
    // AlertasStockService, PedidosService.estadoDeTodasLasLineas — ver
    // DATA_MODEL.md/ALGORITHM.md) hace falta esta regla aparte, con comodín
    // recursivo. Bug real encontrado en producción: se rompían con "Missing or
    // insufficient permissions" hasta añadir esto.
    //
    // Además, a diferencia de las demás colecciones, aquí NO hay forma de
    // derivar la empresa de la ruta (el comodín recursivo no la captura) — por
    // eso cada línea denormaliza su propio campo `empresaId` (mismo patrón ya
    // usado para cocineroId/mesaNumero/pedidoCreadoEn, ver DATA_MODEL.md), y
    // esta regla lo compara directamente. Solo lectura: las escrituras a
    // líneas siempre van por la subcolección concreta, nunca por collection
    // group, así que no hace falta duplicar create/update aquí.
    match /{path=**}/lineas/{lineaId} {
      allow read: if esSuperadmin() || (autenticado() && resource.data.empresaId == miEmpresaId());
    }
  }
}
